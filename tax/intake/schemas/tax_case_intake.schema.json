{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tax_case_intake.schema.json",
  "title": "Tax Case Intake",
  "description": "General tax case intake schema with PII marking for redaction",
  "type": "object",
  "required": [
    "case_id",
    "intake_timestamp",
    "case_type",
    "tax_years",
    "amount_owed_estimate",
    "user_summary"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Unique case identifier (UUID preferred)",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "intake_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of intake"
    },
    "case_type": {
      "type": "string",
      "enum": [
        "back_taxes_owed",
        "irs_notice_response",
        "installment_agreement",
        "offer_in_compromise",
        "audit_support",
        "prep_handoff"
      ],
      "description": "Primary case classification"
    },
    "tax_years": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1900,
        "maximum": 2100
      },
      "minItems": 1,
      "description": "Tax years involved"
    },
    "amount_owed_estimate": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated total amount owed (USD)"
    },
    "user_summary": {
      "type": "string",
      "maxLength": 2000,
      "description": "User's description of the situation (NOT PII - sanitized by user)"
    },
    "pii": {
      "type": "object",
      "description": "PII fields requiring redaction per policies/redaction_rules.md",
      "properties": {
        "name_full": {
          "type": "string",
          "description": "Full legal name (REDACT in logs/proofs)"
        },
        "ssn_last_4": {
          "type": "string",
          "pattern": "^[0-9]{4}$",
          "description": "Last 4 digits of SSN only (never full SSN)"
        },
        "filing_status": {
          "type": "string",
          "enum": ["single", "married_joint", "married_separate", "head_of_household", "qualifying_widow"]
        }
      }
    },
    "has_representation": {
      "type": "boolean",
      "description": "Whether user already has CPA/attorney"
    },
    "urgency_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Based on deadlines (levy notice = critical, general question = low)"
    }
  }
}
