{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "installment_agreement_intake.schema.json",
  "title": "Installment Agreement Intake",
  "description": "Payment plan eligibility and setup guidance (Payment Plan First approach)",
  "type": "object",
  "required": [
    "case_id",
    "intake_timestamp",
    "total_owed",
    "monthly_income_net",
    "monthly_expenses_total",
    "has_filed_all_returns"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "intake_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "total_owed": {
      "type": "number",
      "minimum": 0,
      "description": "Total amount owed to IRS (all years combined)"
    },
    "monthly_income_net": {
      "type": "number",
      "minimum": 0,
      "description": "Monthly net income after taxes"
    },
    "monthly_expenses_total": {
      "type": "number",
      "minimum": 0,
      "description": "Total monthly allowable expenses (per IRS standards)"
    },
    "has_filed_all_returns": {
      "type": "boolean",
      "description": "Whether all required returns are filed (prerequisite for IA)"
    },
    "payment_goal_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 72,
      "description": "Desired payment term in months (max 72 for under $50k)"
    },
    "current_financial_hardship": {
      "type": "boolean",
      "description": "Whether experiencing financial hardship (affects IA type)"
    },
    "pii": {
      "type": "object",
      "properties": {
        "name_full": {
          "type": "string",
          "description": "REDACT in logs/proofs"
        },
        "ssn_last_4": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "filing_status": {
          "type": "string",
          "enum": ["single", "married_joint", "married_separate", "head_of_household"]
        }
      }
    }
  }
}
